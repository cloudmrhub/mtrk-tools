    },
    "instructions": {
        "main": {
            "print_counter": "on",
            "print_message": "Running main loop",
            "steps": [{
                "action": "loop",
                "counter": 1,
                "range": 1,
                "steps": [{
                    "action": "run_block",
                    "block": "block_pe1_loop"
                }]
            }]
        },
        "block_pe1_loop": {
            "print_counter": "on",
            "print_message": "Looping over TI-events (pe1)",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "loop",
                "counter": 3,
                "range": 32,
                "steps": [{
                    "action": "run_block",
                    "block": "block_pe1"
                }]
            },
            {
                "action": "submit"
            }]
        },
        "block_pe1": {
            "print_counter": "on",
            "print_message": "Phase Encoding",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "run_block",
                "block": "block_TI"
            },
            {
                "action": "run_block",
                "block": "block_pe2_loop"
            },
            {
                "action": "run_block",
                "block": "block_recovery"
            },
            {
                "action": "submit"
            }]
        },
        "block_TI": {
            "print_counter": "on",
            "print_message": "Inversion pulse, spoilers and TI",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "rf",
                "object": "rf_prep_obj",
                "time": 0,
                "added_phase": {
                    "type": "float",
                    "float": "0"
                }
            },
            {
                "action": "grad",
                "axis": "read",
                "object": "grad_spoil_x_obj",
                "time": 510
            },
            {
                "action": "grad",
                "axis": "phase",
                "object": "grad_spoil_y_obj",
                "time": 510
            },
            {
                "action": "grad",
                "axis": "slice",
                "object": "grad_spoil_z_obj",
                "time": 510
            },
            {
                "action": "mark",
                "time": {
                    "type": "equation",
                    "equation": "equation_ti_event"
                }
            },
            {
                "action": "submit"
            }]
        },
        "block_pe2_loop": {
            "print_counter": "on",
            "print_message": "Looping over pe2-lines",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "loop",
                "counter": 2,
                "range": 8,
                "steps": [{
                    "action": "run_block",
                    "block": "block_pe2"
                }]
            },
            {
                "action": "submit"
            }]
        },
        "block_pe2": {
            "print_counter": "on",
            "print_message": "Running inner TR, slice encoding",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "run_block",
                "block": "block_GRE"
            },
            {
                "action": "run_block",
                "block": "block_cartesian"
            },
            {
                "action": "run_block",
                "block": "block_spoiler"
            },
            {
                "action": "submit"
            }]
        },
        "block_GRE": {
            "print_counter": "on",
            "print_message": "GRE block (RF + TE)",
            "steps": [{
                "action": "init",
                "gradients": "logical"
            },
            {
                "action": "rf",
                "object": "rf_excitation",
